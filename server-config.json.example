{
  "_": "Minimal server config. Performance defaults are auto-adaptive — do",
  "__": "not set read_buffer / write_buffer / *_receive_window unless you",
  "___": "have a specific reason. See README for the full knob list.",

  "mode": "server",
  "transport": {
    "type": "udp"
  },
  "listen_port": 8080,
  "spoof": {
    "source_ips": ["SERVER_SPOOF_IP"]
  },
  "crypto": {
    "private_key": ""
  },
  "peers": [
    {
      "name": "vpn1",
      "peer_public_key": "",
      "client_real_ip": "CLIENT_REAL_IP",
      "peer_spoof_ips": ["CLIENT_SPOOF_IP"]
    }
  ],
  "reverse_forwards_comment": "ssh -R: open a TCP port on this server and tunnel each connection back to a peer, which dials target on its own host. omit target to default to 127.0.0.1:<listen-port>. bare port or :port binds loopback; set an explicit host (0.0.0.0:8443) to expose it.",
  "reverse_forwards": [
    {
      "listen": "127.0.0.1:8443",
      "target": "127.0.0.1:8443",
      "peer": "vpn1"
    }
  ],
  "obfuscation": {
    "mode": "standard"
  },
  "security": {
    "block_private_targets": true
  },
  "logging": {
    "level": "info",
    "file": ""
  },
  "metrics": {
    "enabled": false,
    "listen": "127.0.0.1:9201"
  }
}
